---
const currentYear = new Date().getFullYear();

const footerLinks = {
  Company: [
    { label: 'About', href: '#about' },
    { label: 'Services', href: '#services' },
    { label: 'Portfolio', href: '#portfolio' },
    { label: 'Contact', href: '#contact' },
  ],
  Services: [
    { label: 'Web App Design & Build', href: '#services' },
    { label: 'MVP Development', href: '#services' },
    { label: 'Startup Scaling', href: '#services' },
    { label: 'AI Workflow Integration', href: '#services' },
  ],
};
---

<footer class="bg-[#0a0d16] border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="#home" class="inline-flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-lg bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center">
            <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5" aria-hidden="true">
              <path d="M4 12C4 7.58172 7.58172 4 12 4C14.5 4 16.75 5.1 18.3 6.9L20 5C18.0 2.9 15.2 1.5 12 1.5C6.20101 1.5 1.5 6.20101 1.5 12C1.5 17.799 6.20101 22.5 12 22.5C15.2 22.5 18.0 21.1 20 19L18.3 17.1C16.75 18.9 14.5 20 12 20C7.58172 20 4 16.4183 4 12Z" fill="#818cf8" />
              <path d="M22 12L17 8V11H12V13H17V16L22 12Z" fill="#22d3ee" />
            </svg>
          </div>
          <span class="text-lg font-semibold text-white">
            Caracara<span class="text-indigo-400"> Software</span>
          </span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          We build high-quality software products, help startups scale, and partner with teams to embed AI into how they work. Let's build something great.
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-4 mt-6">
          <a
            href="https://github.com/CaracaraSoftware"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-indigo-500/50 hover:bg-indigo-500/10 transition-all duration-200"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/company/caracara-software"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-indigo-500/50 hover:bg-indigo-500/10 transition-all duration-200"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Links -->
      <nav aria-label="Footer navigation" class="contents">
      {
        Object.entries(footerLinks).map(([groupName, links]) => (
          <div>
            <h3 class="text-xs font-semibold tracking-widest uppercase text-slate-400 mb-4">
              {groupName}
            </h3>
            <ul class="space-y-3">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-slate-500 hover:text-slate-200 transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      </nav>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-slate-600">
        &copy; {currentYear} Caracara Software. All rights reserved.
      </p>
    </div>
  </div>
</footer>
