---
const values = [
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: 'Speed without sacrifice',
    description: 'We move fast and ship often — without compromising on code quality, security, or scalability.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    title: 'True partnership',
    description: 'We embed with your team, learn your domain, and treat your goals as our own. Communication is never an afterthought.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    title: 'Built to last',
    description: 'Every line of code is written with long-term maintainability in mind. We build systems your future team will thank us for.',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`,
    title: 'Forward-thinking',
    description: 'We stay ahead of the curve — leveraging modern tooling, AI-assisted workflows, and cloud-native patterns to give you an edge.',
  },
];
---

<section id="about" class="section-padding bg-[#0a0d16] relative overflow-hidden">
  <!-- Subtle background accent -->
  <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 pointer-events-none" style="background: radial-gradient(circle, #6366f1 0%, transparent 70%); transform: translate(40%, -40%);"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section label -->
    <div class="flex items-center gap-3 mb-16">
      <span class="w-8 h-px bg-indigo-500"></span>
      <span class="text-xs font-semibold tracking-widest uppercase text-indigo-400">About Us</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left: Story -->
      <div>
        <h2 class="text-4xl sm:text-5xl font-extrabold text-white leading-tight mb-6">
          A team of builders who've been in the trenches.
        </h2>
        <div class="space-y-5 text-slate-400 leading-relaxed">
          <p>
            Caracara Software was founded by engineers who spent years inside fast-growing startups and enterprise organizations. We've shipped software used by millions, led engineering teams through hypergrowth, and modernized legacy systems.
          </p>
          <p>
            We started this agency because we believe great software is about understanding the business problem, designing for real users, and building systems that scale with your ambitions.
          </p>
          <p>
            Today, we work with a focused roster of clients who value technical excellence, transparent communication, and a true partnership mentality. We're intentionally small, relentlessly curious, and deeply invested in the outcomes we help create.
          </p>
        </div>

        <a
          href="#contact"
          class="inline-flex items-center gap-2 mt-10 text-indigo-400 font-semibold hover:text-indigo-300 transition-colors duration-200 group"
        >
          Work with us
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right: Values -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {
          values.map((value) => (
            <div class="p-6 rounded-2xl bg-[#0f1420] border border-white/10 card-hover">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/15 border border-indigo-500/20 flex items-center justify-center text-indigo-400 mb-4" set:html={value.icon} />
              <h3 class="text-base font-semibold text-white mb-2">{value.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{value.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
