---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Thread Stash Support | Caracara Software"
  description="Support information for Thread Stash, including how to get help and what details to send with a support request."
>
  <section class="pt-32 pb-24 bg-[#080b12] relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute top-0 right-0 w-[420px] h-[420px] rounded-full opacity-10 translate-x-1/3 -translate-y-1/3"
        style="background: radial-gradient(circle, #6366f1 0%, transparent 70%);"
      />
      <div
        class="absolute bottom-0 left-0 w-[420px] h-[420px] rounded-full opacity-10 -translate-x-1/3 translate-y-1/3"
        style="background: radial-gradient(circle, #22d3ee 0%, transparent 70%);"
      />
    </div>

    <div class="max-w-4xl mx-auto px-6 lg:px-8 relative">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-indigo-500"></span>
        <span class="text-xs font-semibold tracking-widest uppercase text-indigo-400">
          Thread Stash
        </span>
      </div>

      <div class="rounded-3xl border border-white/10 bg-[#0f1420] p-8 sm:p-12 shadow-2xl shadow-black/20">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-indigo-400 mb-4">
          Support
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white leading-tight mb-4">
          Get help with <span class="gradient-text">Thread Stash</span>
        </h1>
        <p class="text-slate-400 text-base sm:text-lg leading-relaxed mb-10">
          If you need help with Thread Stash, have a bug report, or want to request a feature, use
          the contact details below. We will do our best to respond promptly.
        </p>

        <div class="grid gap-6 sm:grid-cols-2 mb-10">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <p class="text-xs font-semibold tracking-widest uppercase text-slate-500 mb-2">
              Email support
            </p>
            <a
              href="mailto:caracara.software@gmail.com?subject=Thread%20Stash%20Support"
              class="text-lg font-semibold text-indigo-300 hover:text-indigo-200 transition-colors duration-200"
            >
              caracara.software@gmail.com
            </a>
            <p class="text-sm text-slate-400 mt-3">
              Best for help requests, bug reports, account-free support, and store review follow-up.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <p class="text-xs font-semibold tracking-widest uppercase text-slate-500 mb-2">
              Useful links
            </p>
            <div class="space-y-3 text-sm">
              <p>
                <a
                  href="/thread-stash/privacy-policy"
                  class="text-indigo-300 hover:text-indigo-200 transition-colors duration-200"
                >
                  View the Thread Stash Privacy Policy
                </a>
              </p>
              <p class="text-slate-400">
                Caracara Software provides support for the Thread Stash mobile app.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
